{
  "name": "wild-ones-revival",
  "private": true,
  "description": "Wild Ones Revival: servidor de juego y protocolo compartido.",
  "scripts": {
    "start": "pnpm build:protocol && pnpm --filter @wildones/server start",
    "dev": "pnpm build:protocol && pnpm --filter @wildones/server dev",
    "typecheck": "pnpm build:protocol && pnpm -r typecheck",
    "build:protocol": "pnpm --filter @wildones/protocol build",
    "build": "pnpm -r build",
    "assets": "pnpm --filter @wildones/server assets",
    "test": "pnpm build:protocol && pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
