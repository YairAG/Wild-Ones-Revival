# Copia este archivo como .env y ajusta los valores. El .env no se sube a git.

# Puerto TCP donde escucha el servidor de juego
PORT=8000

# Base de datos de jugadores (colección "users")
MONGO_URL=mongodb://localhost:27017/emu

# De dónde se descargan los datos del juego (Config.dat, Maps.dat, ...). Debe terminar en "/"
# `pnpm assets` los sirve desde assets/json en esta URL.
ASSETS_URL=http://localhost:8080/

# Secreto para verificar los JWT de tu backend de cuentas (se usa a partir de la tarea 8)
JWT_SECRET=cambia-esto
