{
  "name": "@wildones/server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor de juego Wild Ones (lobby, partidas, turnos).",
  "main": "app.ts",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env app.ts",
    "dev": "tsx watch --env-file-if-exists=.env app.ts | pino-pretty",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start:dist": "node --env-file-if-exists=.env dist/app.js",
    "assets": "tsx scripts/serve-assets.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "wildones-protocol": "workspace:*",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "7.7.0",
    "pino": "^10.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ws": "^8.18.2",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0"
  }
}
